# Same Redis the backend pipeline writes to (local Docker, or Upstash in production)
REDIS_URL=redis://localhost:6381

# "Actualizar" button (POST /api/refresh) - starts the GitHub Actions pipeline.
# Fine-grained token scoped to this repo only, permission "Actions: Read and write".
GITHUB_DISPATCH_TOKEN=
# owner/repo that holds .github/workflows/refresh.yml
GITHUB_REPO=flasheante/music-intelligence-agent
# Optional (defaults shown):
# GITHUB_WORKFLOW=refresh.yml
# GITHUB_REF_NAME=main
# Minimum minutes between visitor-triggered refreshes (shared by everyone)
# REFRESH_COOLDOWN_MINUTES=30
